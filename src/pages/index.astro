---
import Layout from '~/layouts/PageLayout.astro';
import { circle } from '~/utils/circle';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';
import HeroVideo from '~/components/widgets/HeroVideo.astro';
import ProofStrip from '~/components/widgets/ProofStrip.astro';
import ProductFlow from '~/components/widgets/ProductFlow.astro';
import PainList from '~/components/widgets/PainList.astro';
import PinnedSteps from '~/components/widgets/PinnedSteps.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import FitList from '~/components/widgets/FitList.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import {
  SITE_NAME,
  SITE_URL,
  BOOKING_URL,
  PRICE_BANDS,
  PRICE_SUMMARY,
  bandForBeds,
  monthlyFromAnnual,
  formatINR,
} from '~/site';

const example = bandForBeds(300);

const metadata = {
  title: `${SITE_NAME} | AI Nurse Duty Rostering for Indian Hospitals`,
  description:
    'Your in-charges spend a third of their week on the duty roster. The engine builds every ward roster against the weekly hours cap you set, rest and weekly-off rules; your nursing office approves.',
  ignoreTitleTemplate: true,
};

const actions = [
  { text: 'Book a demo', href: BOOKING_URL, variant: 'primary' as const },
  { text: 'Try the interactive demo', href: '/demo', variant: 'secondary' as const },
];

const faqs = [
  {
    title: 'How long does it take to get started?',
    description:
      'Basic starts with one guided onboarding session. Pro includes four weeks of guided setup: you send the staff Excel you already keep, sit one rules session, and approve the first live roster. Nothing for IT to install.',
  },
  {
    title: 'Do nurses need to install anything?',
    description:
      'No. Nurses get a portal in their phone browser: duty calendar, leave and swap requests, absence reporting. Supervisors approve from the roster side.',
  },
  {
    title: 'What happens when a nurse is absent at 2 AM?',
    description:
      'The engine ranks every eligible replacement with reasons the moment the absence is logged. The supervisor on duty assigns with one tap; the roster and audit trail update themselves.',
  },
  {
    title: 'Which rules does it enforce?',
    description:
      'The ones you set: in-charge cover, skill mix, your weekly hours cap, 12-hour rest, one weekly off, night rotation, approved leave and contract availability. Changes take effect from the next cycle.',
  },
  {
    title: 'We already have an HRMS. Does this replace it?',
    description:
      'No. Keep your HR and payroll. We replace the rostering spreadsheet, or the HRMS roster module that does not enforce rules.',
  },
  {
    title: 'How is it priced?',
    description: `${PRICE_SUMMARY} A 300-bed hospital pays ${formatINR(example.pro)} a year on Pro, whether it rosters 300 nurses or 450. Add nurses, wards and supervisors without your bill changing.`,
  },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${SITE_URL}/#software`,
    name: SITE_NAME,
    url: SITE_URL,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'INR',
      lowPrice: String(PRICE_BANDS[0].basic),
      highPrice: String(PRICE_BANDS[PRICE_BANDS.length - 1].pro),
      offerCount: String(PRICE_BANDS.length * 2),
      description: 'Annual subscription priced by licensed beds, GST extra',
    },
    provider: { '@id': `${SITE_URL}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.title,
      acceptedAnswer: { '@type': 'Answer', text: f.description },
    })),
  },
];

const steps = [
  {
    title: 'Staff list in',
    body: 'The Excel you already keep, no integration project.',
    screen: {
      eyebrow: 'Import',
      title: 'Staff list · 412 nurses · 18 wards',
      rows: [
        ['412 nurses matched', 'Designations, wards and leave read from your sheet', true],
        ['Ward rules mapped', 'In-charge cover, skill mix, your hours cap, rotation', true],
      ] as [string, string, boolean][],
      foot: 'One session with your nursing office.',
    },
  },
  {
    title: 'Three drafts out',
    body: 'Three ward rosters, each checked based on your rules.',
    screen: {
      eyebrow: 'Cycle drafts',
      title: 'Week of 7 Sep · Pick one of three',
      rows: [
        ['Balanced', 'Coverage 100% · Fairness 92 · Overtime 0h', true],
        ['Fairness-first', 'Coverage 100% · Fairness 97 · Overtime 8h', false],
        ['Cost-first', 'Coverage 100% · Fairness 88 · Overtime 0h · least contract cover', false],
      ] as [string, string, boolean][],
      foot: 'Every draft covers every shift. You pick the trade-off.',
    },
  },
  {
    title: 'Nurses on their phones',
    body: 'Duties, leave, swaps and absences in the phone browser.',
    screen: {
      eyebrow: 'Absence logged · Night',
      title: 'Tue 02:14 · Replacement shortlist',
      rows: [
        ['1. Kavitha R. · SN', 'Night-cleared · 32h this week · below night average', true],
        ['2. Arun P. · SN', '40h this week, at the cap if extended', false],
      ] as [string, string, boolean][],
      foot: 'Ranked in seconds, with reasons.',
    },
  },
  {
    title: 'Nursing office approves',
    body: 'Nothing publishes without the nursing office signing off.',
    screen: {
      eyebrow: 'Rule checks',
      title: 'Draft validation · 21 / 21',
      rows: [
        ['In-charge on every shift', '', true],
        ['Hours cap clear for every nurse', '', true],
      ] as [string, string, boolean][],
      foot: 'No rule can be quietly skipped.',
    },
  },
];
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={schema} />

  <DarkHero
    badge="For CNOs and Nursing Superintendents"
    title={`Your in-charges spend a third of their week on the duty roster. Get it done in under ${circle('30 minutes')}.`}
    subtitle="The engine builds every ward's roster based on your rules, nurses see it on their phones, your nursing office approves."
    actions={actions}
    backdrop
    overlap
  >
    <HeroVideo
      src="/videos/srai-launch-landscape.mp4?v=3"
      srcVertical="/videos/srai-launch-vertical.mp4?v=3"
      poster="/videos/srai-launch-poster.png"
      label="Product overview: the engine fills a ward's three-shift week, checks the rules, and ranks a replacement for an absence"
    />
  </DarkHero>

  <ProofStrip
    tiles={[
      { big: "Next month's roster in under 30 minutes", small: 'every ward, based on your rules, ready to publish' },
      { big: '21 automated checks', small: 'on every draft before anyone sees it' },
      { big: 'Nurses on their phones', small: 'duties, leave, swaps, absences on the mobile and desktop apps' },
    ]}
  />

  <ProductFlow />

  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 pb-6 text-center sm:px-6 lg:px-8">
      <a href="/how-it-works" class="font-semibold text-primary-ink underline underline-offset-4"
        >See how it works for the full four-week setup →</a
      >
    </div>
  </section>

  <PainList
    title="Good wards run on a roster nobody trusts."
    items={[
      { title: 'Version drift', body: 'The notice board, the Excel and the WhatsApp photo disagree by Wednesday.' },
      {
        title: 'The hours recount',
        body: 'Every change rechecked by hand. Overtime found on the payroll report, after the fact.',
      },
      {
        title: 'Night rotation fights',
        body: 'The same nurses on nights, the same complaints at the nursing office door.',
      },
      { title: 'Leave clashes', body: 'CL approved on paper, duty still on the grid, nobody covering the gap.' },
      {
        title: 'The 2 AM absence',
        body: 'A round of calls instead of a shortlist. The in-charge covers it herself, again.',
      },
    ]}
  />

  <PinnedSteps
    eyebrow="How it works"
    title="Staff list in. Duty roster out. Your nursing office stays in charge."
    steps={steps}
  />

  <Comparison
    title="Roster in Excel vs roster with SimpleRosterAI"
    leftHead="Roster in Excel"
    rightHead="Roster with SimpleRosterAI"
    rows={[
      {
        label: 'Building the month',
        left: 'One in-charge per ward, a day or two',
        right: 'Three drafts per ward, in minutes',
      },
      {
        label: 'A leave approval',
        left: 'Reopens the month, rebalanced cell by cell',
        right: 'Re-checked automatically, gaps refilled from the shortlist',
      },
      {
        label: 'An absence at 2 AM',
        left: 'A round of calls, or the in-charge covers',
        right: 'Ranked replacements with reasons, one tap',
      },
      {
        label: 'Nights and weekends',
        left: 'Remembered by whoever lost out',
        right: 'Tracked per nurse, across weeks',
      },
      { label: 'Hours and overtime', left: 'Seen after payroll', right: 'Flagged before the roster publishes' },
      {
        label: 'Audit trail',
        left: 'Whoever last edited the file',
        right: 'Who changed what, when, exportable for NABH',
      },
    ]}
  />

  <section class="bg-ink text-ivory">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 lg:py-16">
      <div class="max-w-2xl" data-reveal>
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">Pricing</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">Priced by beds, not by nurses.</h2>
        <p class="mt-4 text-lg text-ivory/70">
          A 300-bed hospital pays {formatINR(example.pro)} a year on Pro, or
          {formatINR(monthlyFromAnnual(example.pro))} a month, GST extra, whether it rosters 300 nurses or 450. Add nurses,
          wards and supervisors without your bill changing.
        </p>
        <a href="/pricing" class="mt-6 inline-block font-semibold text-primary-ink underline underline-offset-4"
          >See full pricing →</a
        >
      </div>
    </div>
  </section>

  <FitList
    title="You are a fit if"
    items={[
      'You run a 300+ bed hospital or hospital group',
      'Rosters run in Excel or a rules-blind HRMS module',
      'In-charges lose days each month building the roster',
      'Overtime and contract cover show up unexplained on reports',
      'NABH audits need hours and rest records you assemble by hand',
    ]}
    notFit="Not yet a fit: hospitals under 100 beds, or wards already on a roster system that enforces your rules."
  />

  <FAQs title="Frequently asked questions" tagline="Common questions" items={faqs} />

  <CallToAction
    title="See it on one of your own wards."
    subtitle="A 30-minute demo on your roster, your rules, your shift pattern."
    tagline="Book a demo"
    actions={actions}
  />
</Layout>
