---
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Manrope Variable';
    --aw-font-heading: 'Manrope Variable';

    /* Navy + saffron system — see docs/superpowers/specs/2026-09-03-landing-redesign-design.md §3 */
    --aw-color-primary: #f5a623; /* saffron */
    --aw-color-primary-ink: #a8620a; /* saffron, darkened for AA text on light backgrounds */
    --aw-color-secondary: #d98f0f; /* saffron hover */
    --aw-color-accent: #2aa79b; /* teal */

    --aw-color-text-heading: rgb(11 31 58);
    --aw-color-text-default: rgb(11 31 58);
    --aw-color-text-muted: rgb(11 31 58 / 66%);
    --aw-color-bg-page: #f7f8fa;
    --aw-color-bg-page-dark: #0b1f3a;
    --aw-color-hairline: rgb(11 31 58 / 12%);

    --aw-rgb-ink: 11 31 58;
    --aw-rgb-ivory: 247 248 250;
    --aw-rgb-sage: 42 167 155; /* teal: "passed" states and accents on navy */

    ::selection {
      background-color: rgb(245 166 35 / 30%);
    }
  }

  h1,
  h2,
  h3 {
    font-family: var(--aw-font-heading);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  body {
    font-feature-settings:
      'liga' 1,
      'kern' 1;
    -webkit-font-smoothing: antialiased;
  }

  a {
    text-underline-offset: 3px;
  }
</style>
