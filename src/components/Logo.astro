---
import { SITE } from 'astrowind:config';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 flex items-center gap-2 text-2xl md:text-[1.35rem] font-heading font-semibold tracking-tight text-default whitespace-nowrap"
>
  {/* Concept B "The Route": an S drawn as one route through the schedule, from open shift (dot) to done */}
  <svg width="26" height="26" viewBox="0 0 96 96" aria-hidden="true" class="shrink-0">
    <circle cx="83" cy="23" r="7" fill="#7BAF9B"></circle>
    <path
      d="M 69 23 H 38 a 15 15 0 0 0 0 30 h 20 a 15 15 0 0 1 0 30 H 15"
      fill="none"
      stroke="currentColor"
      stroke-width="14"
      stroke-linecap="round"></path>
  </svg>
  <span>{SITE?.name}<span class="text-primary">.</span></span>
</span>
