---
export interface Props {
  title: string;
  leftHead: string;
  rightHead: string;
  rows: { label: string; left: string; right: string }[];
}
const { title, leftHead, rightHead, rows } = Astro.props;
---

<section class="bg-page border-t border-hairline">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <h2 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>{title}</h2>

    <div class="mt-8 hidden overflow-x-auto rounded-2xl border border-hairline bg-white md:block" data-reveal>
      <table class="w-full min-w-[40rem] text-sm">
        <thead>
          <tr class="border-b border-hairline bg-page text-left">
            <th class="w-40 px-5 py-4 font-bold text-muted">&nbsp;</th>
            <th class="px-5 py-4 font-bold text-red-700">{leftHead}</th>
            <th class="px-5 py-4 font-bold" style="color: #1f8c82">{rightHead}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr class="border-b border-hairline last:border-0 align-top">
                <th scope="row" class="px-5 py-4 text-left font-semibold text-ink">
                  {r.label}
                </th>
                <td class="bg-red-50/60 px-5 py-4 text-muted">{r.left}</td>
                <td class="px-5 py-4 text-ink">
                  <span class="mr-2 inline-block h-2 w-2 rounded-full bg-sage" aria-hidden="true" />
                  {r.right}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ul class="mt-8 space-y-4 md:hidden" data-reveal>
      {
        rows.map((r) => (
          <li class="rounded-2xl border border-hairline bg-white p-5">
            <h3 class="font-heading text-base font-bold text-ink">{r.label}</h3>
            <p class="mt-3 flex items-start gap-2 text-sm text-muted">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-red-600" aria-hidden="true" />
              <span>
                <span class="block text-xs font-bold uppercase tracking-wide text-red-700">{leftHead}</span>
                {r.left}
              </span>
            </p>
            <p class="mt-3 flex items-start gap-2 text-sm text-ink">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-sage" aria-hidden="true" />
              <span>
                <span class="block text-xs font-bold uppercase tracking-wide" style="color: #1f8c82">
                  {rightHead}
                </span>
                {r.right}
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
