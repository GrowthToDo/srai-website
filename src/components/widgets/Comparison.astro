---
export interface Props {
  title: string;
  leftHead: string;
  rightHead: string;
  rows: { label: string; left: string; right: string }[];
}
const { title, leftHead, rightHead, rows } = Astro.props;
---

<section class="bg-page border-t border-hairline">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <h2 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>{title}</h2>
    <div class="mt-8 overflow-x-auto rounded-2xl border border-hairline bg-white" data-reveal>
      <table class="w-full min-w-[40rem] text-sm">
        <thead>
          <tr class="border-b border-hairline bg-page text-left">
            <th class="w-40 px-5 py-4 font-bold text-muted">&nbsp;</th>
            <th class="px-5 py-4 font-bold text-red-700">{leftHead}</th>
            <th class="px-5 py-4 font-bold text-sage">{rightHead}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr class="border-b border-hairline last:border-0 align-top">
                <th scope="row" class="px-5 py-4 text-left font-semibold text-ink">
                  {r.label}
                </th>
                <td class="px-5 py-4 text-muted">{r.left}</td>
                <td class="px-5 py-4 text-ink">
                  <span class="mr-2 inline-block h-2 w-2 rounded-full bg-sage" aria-hidden="true" />
                  {r.right}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
