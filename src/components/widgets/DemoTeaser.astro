---
import DemoScheduler from '~/components/demo-scheduler/DemoScheduler.svelte';

export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
}
const { title, subtitle, ctaText = 'Try the interactive demo', ctaHref = '/demo' } = Astro.props;
---

<section class="bg-page border-t border-hairline" id="demo">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">Try it yourself</p>
      <h2 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-muted">{subtitle}</p>
    </div>
    <div class="mt-8">
      <DemoScheduler client:visible />
    </div>
    <div class="mt-8 text-center" data-reveal>
      <a href={ctaHref} class="btn-primary">{ctaText}</a>
    </div>
  </div>
</section>
