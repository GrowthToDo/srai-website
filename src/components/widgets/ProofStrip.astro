---
export interface Props {
  tiles: { big: string; small: string }[];
}
const { tiles } = Astro.props;
---

<section class="bg-page">
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-20 sm:px-6 sm:pt-28 lg:px-8 lg:pt-36 lg:pb-12">
    <ul class="grid gap-4 sm:grid-cols-3" data-reveal-group>
      {
        tiles.map((t) => (
          <li class="rounded-2xl border border-hairline bg-white px-6 py-6 shadow-[0_20px_40px_-30px_rgb(11_31_58/0.35)]">
            <p class="font-heading text-xl font-bold text-ink sm:text-2xl">{t.big}</p>
            <p class="mt-1 text-sm text-muted">{t.small}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
