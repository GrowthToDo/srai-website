---
import { Icon } from 'astro-icon/components';
import { getHomePermalink } from '~/utils/permalinks';
import { BOOKING_URL } from '~/site';
import Logo from '~/components/Logo.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;
---

<footer class="relative not-prose bg-ink text-ivory">
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    {/* Brand Section with CTA Buttons */}
    <div class="border-b border-ivory/15 py-8 md:py-12">
      <div class="max-w-3xl">
        <a href={getHomePermalink()} class="inline-block mb-4">
          <Logo variant="light" />
        </a>
        <p class="text-ivory/70 mb-6 text-base leading-relaxed">
          AI nurse duty rostering for Indian hospitals. The engine builds every ward roster based on your rules, your
          nursing office approves, and every nurse sees their duties on their phone.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/how-it-works" class="btn-secondary-dark">How it works</a>
          <a href="/demo" class="btn-secondary-dark">Try the interactive demo</a>
          <a href={BOOKING_URL} class="btn-primary">Book a demo</a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <div class="text-sm text-ivory/60 flex gap-1">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a
                  class="text-ivory/60 hover:text-ivory hover:underline transition duration-150 ease-in-out"
                  href={href}
                  set:html={text}
                />
              </>
            ))
          }
        </div>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="font-heading font-medium mb-2 text-ivory">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li class="mb-2">
                    <a
                      class="text-ivory/60 hover:text-ivory hover:underline transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-ivory/15">
      {
        socialLinks?.length ? (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-ivory/60 hover:text-ivory hover:bg-ivory/10 focus:outline-none rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }

      <div class="text-sm mr-4 text-ivory/60">
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>
</footer>
