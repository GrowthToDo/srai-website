---
import EngineDemo from './EngineDemo.svelte';
---

<section class="bg-page border-t border-hairline" id="engine">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-ink">AI rostering engine</p>
      <h2 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">
        From blank grid to a published roster in seconds.
      </h2>
      <p class="mt-4 text-lg text-muted">
        The engine checks your ward rules as it fills every seat, then ranks cover for an absence the same way.
        Automatically.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-[920px]" data-reveal>
      <EngineDemo client:visible />
      <p class="mt-4 text-center text-xs text-muted">
        A sample ward: 77 duty seats across morning, evening and night. Illustrative data.
      </p>
    </div>

    <div class="mt-8 text-center" data-reveal>
      <a href="/demo" class="btn-primary">Try the interactive demo</a>
    </div>
  </div>
</section>
